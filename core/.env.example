# Copia este archivo como .env (en esta misma carpeta, core\) y rellena lo que necesites.
# .env nunca se sube a GitHub.

ASISTENTE_LLM_MODEL=qwen3:4b-instruct
ASISTENTE_VISION_MODEL=moondream
ASISTENTE_WHISPER_MODEL=small
ASISTENTE_PIPER_VOICE=es_MX-ald-medium

# --- Copias de seguridad cifradas -------------------------------------------------
# Frase secreta para cifrar las copias. APÚNTALA FUERA DE LA PC (gestor de contraseñas o
# papel): sin ella las copias no se pueden recuperar, ni siquiera tú.
ASISTENTE_BACKUP_PASSPHRASE=

# Cada cuántas horas hacer una copia automática.
ASISTENTE_BACKUP_INTERVAL_HOURS=24

# Carpeta para la copia local (mejor en otro disco o en una memoria USB).
# ASISTENTE_BACKUP_LOCAL_DIR=D:\Respaldos\Moni

# Supabase: URL del proyecto y clave service_role (Project Settings > API).
# La clave service_role da acceso total al proyecto: no la compartas.
ASISTENTE_SUPABASE_URL=
ASISTENTE_SUPABASE_SERVICE_KEY=
ASISTENTE_SUPABASE_BUCKET=moni-respaldos

# Seguridad: al revisar un archivo, Moni consulta solo su hash (nunca el archivo) en
# CIRCL hashlookup. Pon false para no consultar nada en internet.
# ASISTENTE_SECURITY_HASH_LOOKUP=true
# Opcional: clave gratuita de abuse.ch (https://auth.abuse.ch) para consultar MalwareBazaar.
# ASISTENTE_ABUSECH_AUTH_KEY=

# Voz: cargar Whisper y Piper al arrancar (true) o la primera vez que se usa el micrófono.
# ASISTENTE_VOICE_PRELOAD=true
# Interrumpir a Moni hablándole mientras habla (con parlantes puede saltar por el eco).
# ASISTENTE_VOICE_BARGE_IN=true
